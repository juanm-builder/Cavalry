{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Least-privilege capabilities required by Cavalry's main desktop window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "x-apple.systempreferences:*"
        },
        {
          "url": "ms-settings:*"
        }
      ]
    },
    "updater:default",
    "deep-link:default"
  ]
}
