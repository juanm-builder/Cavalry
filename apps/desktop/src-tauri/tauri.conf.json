{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cavalry",
  "version": "2.2.3",
  "identifier": "com.juanmbuilder.cavalry.mac",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cavalry",
        "width": 1440,
        "height": 1000,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "maximized": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0b0b0b",
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* ws://localhost:*; media-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Finance",
    "shortDescription": "Local-first personal finance for desktop.",
    "longDescription": "Cavalry is a detailed but approachable local-first personal finance application.",
    "copyright": "Copyright \u00a9 2026 Cavalry",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["cavalry"]
      }
    },
    "updater": {
      "pubkey": ""
    }
  }
}
