# Cavalry Advisor llama.cpp configuration
# Copy this file to config.env for local use. Do not commit config.env.
# Default model: Qwen3.5-9B-UD-Q4_K_XL.gguf
# Set MODEL_PATH to your downloaded GGUF, or leave it blank and the launcher will ask.
# If you use LLAMA_API_KEY, enter the same value in Cavalry's Advisor Model settings.

MODEL_PATH=
HF_REPO=
HF_FILE=
HOST=127.0.0.1
PORT=8080
LLAMA_SERVER_BIN=
LLAMA_ALIAS=cavalry-advisor
LLAMA_API_KEY=
LLAMA_CTX_SIZE=32768
LLAMA_PARALLEL=
LLAMA_GPU_LAYERS=auto
LLAMA_FLASH_ATTN=auto
LLAMA_JINJA=1
LLAMA_REASONING=off
LLAMA_NO_UI=1
LLAMA_NO_KV_OFFLOAD=
LLAMA_CACHE_TYPE_K=
LLAMA_CACHE_TYPE_V=
LLAMA_MLOCK=
LLAMA_EXTRA_ARGS=
