# Auto detect text files and perform LF normalization
* text=auto

# Scripts and configuration must be reproducible across runner operating systems.
*.cjs text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Keep binary assets out of text normalization and noisy diffs.
*.gif -text
*.icns -text
*.ico -text
*.jpg -text
*.jpeg -text
*.png -text
*.webp -text
*.woff -text
*.woff2 -text

# Dependency locks are reviewable but should not dominate GitHub language statistics.
package-lock.json linguist-generated=true
