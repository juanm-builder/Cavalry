{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "checkJs": false
  },
  "include": [
    "apps/desktop/src/**/*",
    "apps/desktop/scripts/**/*",
    "packages/*/src/**/*",
    "packages/*/scripts/**/*",
    "tools/repo/**/*"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/out/**",
    "**/test-artifacts/**",
    "apps/desktop/src/renderer/legacy/**"
  ]
}
